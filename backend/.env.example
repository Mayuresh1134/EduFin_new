# Copy this file to .env and fill it in.

# Signs login tokens. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=

# Where MongoDB lives. The database name is the last part of the URI.
MONGO_URI=mongodb://localhost:27017/edufin

# "mongo" uses MONGO_URI. "memory" runs without MongoDB installed:
# everything works, but all data is lost when the server stops.
EDUFIN_DB=mongo

PORT=5050

# Optional. Turns on the "Continue with Google" buttons.
# Create an OAuth 2.0 Web client ID in Google Cloud Console and add
# http://localhost:5173 (and your production URL) as an authorised JavaScript origin.
GOOGLE_CLIENT_ID=

# Optional. Only needed when the frontend is served from a different origin
# than the API (comma-separated). Not needed for `npm run dev` or the built app.
CORS_ORIGINS=
